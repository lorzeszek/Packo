<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Packo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Packo.Views"
    xmlns:loc="clr-namespace:Packo.Extensions"
    FlyoutBehavior="Disabled"
    Title="Packo"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}"
    Shell.NavBarHasShadow="False"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource PackoShellUnselectedLight}, Dark={StaticResource PackoShellUnselectedDark}}"
    Shell.DisabledColor="{AppThemeBinding Light={StaticResource PackoShellDisabledLight}, Dark={StaticResource PackoShellDisabledDark}}">

    <Shell.TitleView>
        <views:ShellHeaderView />
    </Shell.TitleView>

    <TabBar>
        <ShellContent
            Title="{loc:Translate TabHome}"
            Icon="tab_home.svg"
            Route="Home"
            ContentTemplate="{DataTemplate views:StartPage}" />

        <ShellContent
            Title="{loc:Translate TabTrips}"
            Icon="tab_trips.svg"
            Route="TripList"
            ContentTemplate="{DataTemplate views:TripListPage}" />

        <ShellContent
            Title="{loc:Translate TabWeather}"
            Icon="tab_weather.svg"
            Route="Weather"
            ContentTemplate="{DataTemplate views:WeatherPage}" />

        <ShellContent
            Title="{loc:Translate TabDocs}"
            Icon="tab_docs.svg"
            Route="Docs"
            ContentTemplate="{DataTemplate views:DocsPage}" />

        <ShellContent
            Title="{loc:Translate TabSettings}"
            Icon="tab_settings.svg"
            Route="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>

</Shell>
