<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                xmlns:viewmodels="clr-namespace:Packo.ViewModels"
                xmlns:local="clr-namespace:Packo.Models.Pages"
                x:Class="Packo.Views.PackingListPage"
                x:Name="PackingListPageRoot"
                x:DataType="viewmodels:PackingListViewModel"
                Title="Packing list"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <BoolToOpacityConverter x:Key="PackedOpacityConverter" TrueOpacity="0.55" FalseOpacity="1" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,20,22,14" Spacing="6">
            <Label Text="ONE THING AT A TIME" FontSize="11" CharacterSpacing="2.1"
                   FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
            <Label Text="Packing list" FontSize="29" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="Check items off as they find their way into your bag."
                   FontSize="14" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>

        <CollectionView x:Name="PackingListView" Grid.Row="1" ItemsSource="{Binding Items}"
                        SelectionMode="None" VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border WidthRequest="74" HeightRequest="74" StrokeThickness="0"
                            StrokeShape="RoundRectangle 25" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                            HorizontalOptions="Center">
                        <Label Text="✓" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
                    </Border>
                    <Label Text="Your list is ready for ideas" FontSize="19" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                    <Label Text="Add your first item below and start planning."
                           FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="PackingItem">
                    <Border Margin="20,5" Padding="10,7" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                            StrokeShape="RoundRectangle 17"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding IsPacked}" Color="{StaticResource PackoAccentLight}"
                                      Command="{Binding BindingContext.ToggleIsPackedCommand, Source={x:Reference PackingListView}}"
                                      CommandParameter="{Binding .}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="15"
                                   VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                   Opacity="{Binding IsPacked, Converter={StaticResource PackedOpacityConverter}}"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Padding="16,10,16,16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Padding="12,2" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                        StrokeShape="RoundRectangle 17" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <Entry Placeholder="Dodaj przedmiot..." ReturnType="Done"
                           Text="{Binding NewItemName, Mode=TwoWay}" FontSize="15">
                        <Entry.Behaviors>
                            <EventToCommandBehavior EventName="Completed" Command="{Binding AddItemCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
                <Button Grid.Column="1" Text="+" FontSize="25" FontAttributes="Bold"
                        WidthRequest="56" HeightRequest="56" Padding="0" CornerRadius="18"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                        Command="{Binding AddItemCommand}" />
            </Grid>
        </Border>
    </Grid>
</local:BasePage>
