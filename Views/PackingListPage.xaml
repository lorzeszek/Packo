<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                xmlns:viewmodels="clr-namespace:Packo.ViewModels"
                xmlns:helpers="clr-namespace:Packo.Helpers"
                xmlns:loc="clr-namespace:Packo.Extensions"
                xmlns:local="clr-namespace:Packo.Models.Pages"
                x:Class="Packo.Views.PackingListPage"
                x:Name="PackingListPageRoot"
                x:DataType="viewmodels:PackingListViewModel"
                Title="{loc:Translate PackingListTitle}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <BoolToOpacityConverter x:Key="PackedOpacityConverter" TrueOpacity="0.55" FalseOpacity="1" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,20,22,14" Spacing="6">
            <Label Text="{loc:Translate PackingEyebrow}" FontSize="11" CharacterSpacing="2.1"
                   FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
            <Label Text="{loc:Translate PackingListTitle}" FontSize="29" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="{Binding TripDestination}" IsVisible="{Binding HasTripDestination}"
                   FontSize="17" FontAttributes="Bold" LineBreakMode="WordWrap" MaxLines="2"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="{Binding TripDatesRange}" IsVisible="{Binding HasTripDates}"
                   FontSize="13" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasItems}">
                <Button Text="{loc:Translate ClearPackingList}" Command="{Binding ClearListCommand}"
                        IsEnabled="{Binding CanEditItems}" HorizontalOptions="Start"
                        FontSize="13" FontAttributes="Bold" MinimumHeightRequest="44" Padding="12,0" CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light=#FDE8E7, Dark=#432429}"
                        TextColor="{AppThemeBinding Light=#9E3030, Dark=#F3A7A6}" />
                <Button Grid.Column="1" Text="{loc:Translate PackingSortButton}" Command="{Binding SelectSortCommand}"
                        IsEnabled="{Binding CanEditItems}" SemanticProperties.Hint="{loc:Translate PackingSortTitle}"
                        FontSize="13" FontAttributes="Bold" MinimumHeightRequest="44" Padding="12,0" CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentStrongDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SortMode}" Value="{x:Static helpers:PackingItemSortMode.PackedFirst}">
                            <Setter Property="Text" Value="{loc:Translate PackingSortPackedButton}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SortMode}" Value="{x:Static helpers:PackingItemSortMode.NameAscending}">
                            <Setter Property="Text" Value="A–Z ▾" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SortMode}" Value="{x:Static helpers:PackingItemSortMode.NameDescending}">
                            <Setter Property="Text" Value="Z–A ▾" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SortMode}" Value="{x:Static helpers:PackingItemSortMode.QuantityDescending}">
                            <Setter Property="Text" Value="{loc:Translate PackingSortQuantityDescendingButton}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding SortMode}" Value="{x:Static helpers:PackingItemSortMode.QuantityAscending}">
                            <Setter Property="Text" Value="{loc:Translate PackingSortQuantityAscendingButton}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </VerticalStackLayout>

        <CollectionView x:Name="PackingListView" Grid.Row="1" ItemsSource="{Binding Items}"
                        SelectionMode="None" ItemsUpdatingScrollMode="KeepScrollOffset"
                        VerticalScrollBarVisibility="Never" IsEnabled="{Binding CanEditItems}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border WidthRequest="74" HeightRequest="74" StrokeThickness="0"
                            StrokeShape="RoundRectangle 25" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                            HorizontalOptions="Center">
                        <Label Text="✓" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
                    </Border>
                    <Label Text="{loc:Translate ListReady}" FontSize="19" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                    <Label Text="{loc:Translate AddFirstItem}"
                           FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="PackingItem">
                    <Border Margin="20,5" Padding="10,7" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                            StrokeShape="RoundRectangle 17"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding IsPacked, Mode=OneWay}" Color="{StaticResource PackoAccentLight}"
                                      CheckedChanged="OnPackedChanged" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="15"
                                   VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                   Opacity="{Binding IsPacked, Converter={StaticResource PackedOpacityConverter}}"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                            <Button Grid.Column="2" Text="{Binding Quantity}" FontSize="15" FontAttributes="Bold"
                                    MinimumWidthRequest="44" MinimumHeightRequest="44" HeightRequest="44" Padding="10,0" CornerRadius="12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentStrongDark}}"
                                    SemanticProperties.Description="{loc:Translate EditPackingQuantity}"
                                    Command="{Binding BindingContext.EditQuantityCommand, Source={x:Reference PackingListView}}"
                                    CommandParameter="{Binding .}" />
                            <Button Grid.Column="3" VerticalOptions="Center" Text="&#xE872;" FontFamily="MaterialIcons" FontSize="21"
                                    WidthRequest="44" HeightRequest="44" Padding="0" CornerRadius="12"
                                    BackgroundColor="Transparent" TextColor="#C24141"
                                    SemanticProperties.Description="{loc:Translate DeletePackingItem}"
                                    Command="{Binding BindingContext.DeleteItemCommand, Source={x:Reference PackingListView}}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Padding="16,10,16,16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
            <VerticalStackLayout Spacing="10" IsEnabled="{Binding CanEditItems}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Border Padding="12,2" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                            StrokeShape="RoundRectangle 17" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                        <Entry Placeholder="{loc:Translate AddItemPlaceholder}" ReturnType="Done"
                               Text="{Binding NewItemName, Mode=TwoWay}" FontSize="15">
                            <Entry.Behaviors>
                                <EventToCommandBehavior EventName="Completed" Command="{Binding AddItemCommand}" />
                            </Entry.Behaviors>
                        </Entry>
                    </Border>
                    <Button Grid.Column="1" Text="+" FontSize="25" FontAttributes="Bold"
                            WidthRequest="56" HeightRequest="56" Padding="0" CornerRadius="18"
                            BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                            Command="{Binding AddItemCommand}" />
                </Grid>
                <Button Text="{loc:Translate GeneratePackingList}" Command="{Binding GeneratePackingListCommand}"
                        IsVisible="{Binding CanGeneratePackingList}"
                        Style="{StaticResource PackoPrimaryActionButtonStyle}" FontSize="14" FontAttributes="Bold"
                        HeightRequest="48" CornerRadius="15" />
                <Button Text="{loc:Translate CopyPackingList}" Command="{Binding CopyPackingListCommand}"
                        IsVisible="{Binding CanCopyPackingList}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentStrongDark}}"
                        FontSize="14" FontAttributes="Bold" HeightRequest="48" CornerRadius="15" />
            </VerticalStackLayout>
        </Border>

        <Grid Grid.RowSpan="3" IsVisible="{Binding IsGeneratingPackingList}"
              BackgroundColor="#80000000" ZIndex="10">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsGeneratingPackingList}"
                                   WidthRequest="40" HeightRequest="40" />
                <Label Text="{loc:Translate Loading}" TextColor="White"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</local:BasePage>
