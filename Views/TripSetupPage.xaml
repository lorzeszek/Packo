<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns="http://schemas.microsoft.com/dotnet/maui/global"
              x:Name="TripSetupPageRoot"
             x:Class="Packo.Views.TripSetupPage"
             xmlns:viewmodels="clr-namespace:Packo.ViewModels"
             xmlns:local="clr-namespace:Packo.Models.Pages"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="TripSetupViewModel"                
             Title="TripSetupPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <Grid RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Row="0" Grid.ColumnSpan="2">
                <Label Text="Destination:" FontSize="20" />
                <Entry Placeholder="Destination..." Text="{Binding Destination}"/>
            </StackLayout>

            <StackLayout Grid.Row="1" Grid.Column="0">
                <Label Text="Start date" FontSize="20" />
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="&#xe935;" FontFamily="MaterialIcons" FontSize="24" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStartDateIconTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <DatePicker x:Name="StartDatePicker" Date="{Binding StartDate}" MinimumDate="{x:Static sys:DateTime.Today}" Format="dd MMM yyyy" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </StackLayout>

            <StackLayout Grid.Row="1" Grid.Column="1">
                <Label Text="End date" FontSize="20" />
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="&#xe935;" FontFamily="MaterialIcons" FontSize="24" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEndDateIconTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <DatePicker x:Name="EndDatePicker" Date="{Binding EndDate}" MinimumDate="{Binding StartDate}" Format="dd MMM yyyy" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </StackLayout>

            <StackLayout Grid.Row="2" Grid.ColumnSpan="2">
                <Label Text="Participants:" FontSize="20" />

                <Label Text="Adults" Margin="0,12,0,0"/>
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <!--<Label Text="Adults" FontSize="20"/>-->
                    <Button Text="-" Command="{Binding DecreaseAdultsCountCommand}" WidthRequest="48" />
                    <Label Text="{Binding AdultsCount}" FontSize="18" VerticalOptions="Center" />
                    <Button Text="+" Command="{Binding IncreaseAdultsCountCommand}" WidthRequest="48" />
                </HorizontalStackLayout>

                <Label Text="Children" Margin="0,12,0,0"/>
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <!--<Label Text="Children" FontSize="20"/>-->
                    <Button Text="-" Command="{Binding DecreaseChildrenCountCommand}" WidthRequest="48" />
                    <Label Text="{Binding ChildrenCount}" FontSize="18" VerticalOptions="Center" />
                    <Button Text="+" Command="{Binding IncreaseChildrenCountCommand}" WidthRequest="48" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasChildren}" BindableLayout.ItemsSource="{Binding Children}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label Text="Child age" VerticalOptions="Center" FontSize="20" />
                                <Button Text="-" Command="{Binding DecreaseAgeCommand}" WidthRequest="48" />
                                <Label Text="{Binding Age}" FontSize="18" VerticalOptions="Center" />
                                <Button Text="+" Command="{Binding IncreaseAgeCommand}" WidthRequest="48" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!--<Label Text="Transport" Margin="0,20,0,0" FontSize="20"/>
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TransportOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                <Label Text="{Binding Name}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>-->
            </StackLayout>

            <StackLayout Grid.Row="3" Grid.ColumnSpan="2">

                <Label Text="Transport" Margin="0,20,0,0" FontSize="20"/>
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TransportOptions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <HorizontalStackLayout VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                <Label Text="{Binding Name}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </StackLayout>



            </Grid>
            <Button
                Text="Utwórz listę"
                Command="{Binding CreateTripCommand}" />
        </VerticalStackLayout>
    </ScrollView>
    
</local:BasePage>