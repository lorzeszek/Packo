<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                xmlns:loc="clr-namespace:Packo.Extensions"
                xmlns:local="clr-namespace:Packo.Models.Pages"
                xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                x:Name="TripSetupPageRoot"
                x:Class="Packo.Views.TripSetupPage"
                x:DataType="TripSetupViewModel"
                Title="{Binding PageTitle}"
                HideSoftInputOnTapped="True"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,22,22,28" Spacing="22">
                <VerticalStackLayout Spacing="7">
                    <Label Text="{loc:Translate TripSetupEyebrow}" FontSize="11" CharacterSpacing="2.2"
                           FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
                    <Label Text="{Binding Heading}" FontSize="29" LineHeight="1.05"
                           FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                    <Label Text="{Binding Intro}"
                           FontSize="14" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                </VerticalStackLayout>

                <Border Padding="18" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                        StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Translate DestinationQuestion}" Style="{StaticResource PackoSectionTitleStyle}" />
                        <Border Padding="14,2" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                            <Entry Placeholder="{loc:Translate DestinationPlaceholder}" Text="{Binding Destination}"
                                   FontSize="16" ClearButtonVisibility="WhileEditing" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                        StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{loc:Translate DateQuestion}" Style="{StaticResource PackoSectionTitleStyle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="7">
                                <Label Text="{loc:Translate Start}" Style="{StaticResource PackoFieldCaptionStyle}" FontAttributes="Bold" CharacterSpacing="1" />
                                <Border Padding="10,5" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                        StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Label Text="&#xe935;" FontFamily="MaterialIcons" FontSize="19"
                                               TextColor="{StaticResource PackoAccentLight}" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnStartDateIconTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <DatePicker x:Name="StartDatePicker" Grid.Column="1" Date="{Binding StartDate}"
                                                    MinimumDate="{Binding MinimumStartDate}" Format="dd MMM yyyy"
                                                    FontSize="13" HorizontalOptions="Fill" />
                                    </Grid>
                                </Border>
                                <Label Text="{loc:Translate StartTime}" Style="{StaticResource PackoFieldCaptionStyle}" />
                                <Border Padding="10,5" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                        StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                    <TimePicker Time="{Binding StartTime}" Format="HH:mm" FontSize="15"
                                                SemanticProperties.Description="{loc:Translate StartTime}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="7">
                                <Label Text="{loc:Translate End}" Style="{StaticResource PackoFieldCaptionStyle}" FontAttributes="Bold" CharacterSpacing="1" />
                                <Border Padding="10,5" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                        StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                        <Label Text="&#xe935;" FontFamily="MaterialIcons" FontSize="19"
                                               TextColor="{StaticResource PackoAccentLight}" VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEndDateIconTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <DatePicker x:Name="EndDatePicker" Grid.Column="1" Date="{Binding EndDate}"
                                                    MinimumDate="{Binding StartDate}" Format="dd MMM yyyy"
                                                    FontSize="13" HorizontalOptions="Fill" />
                                    </Grid>
                                </Border>
                                <Label Text="{loc:Translate EndTime}" Style="{StaticResource PackoFieldCaptionStyle}" />
                                <Border Padding="10,5" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                        StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                    <TimePicker Time="{Binding EndTime}" Format="HH:mm" FontSize="15"
                                                SemanticProperties.Description="{loc:Translate EndTime}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{loc:Translate ReminderTripZone}" Style="{StaticResource PackoFieldCaptionStyle}" />
                        <Picker ItemsSource="{Binding TimeZoneIds}" SelectedItem="{Binding SelectedTimeZoneId}"
                                FontSize="13" SemanticProperties.Description="{loc:Translate ReminderTripZone}" />
                        <Label Text="{loc:Translate TripScheduleError}" IsVisible="{Binding HasScheduleError}"
                               FontSize="13" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                        StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate TravelersQuestion}" Style="{StaticResource PackoSectionTitleStyle}" />
                            <Label Text="{loc:Translate TravelersDescription}" Style="{StaticResource PackoFieldCaptionStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="12">
                            <Border Padding="12" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                    StrokeShape="RoundRectangle 17" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{loc:Translate Adults}" FontSize="14" FontAttributes="Bold"
                                           VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="44,Auto,44" ColumnSpacing="6" VerticalOptions="Center">
                                        <Button Text="−" WidthRequest="44" HeightRequest="44" Style="{StaticResource PackoCounterButtonStyle}" Command="{Binding DecreaseAdultsCountCommand}" />
                                        <Label Grid.Column="1" Text="{Binding AdultsCount}" FontSize="17" FontAttributes="Bold"
                                               MinimumWidthRequest="32" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                        <Button Grid.Column="2" Text="+" WidthRequest="44" HeightRequest="44" Style="{StaticResource PackoCounterButtonStyle}" Command="{Binding IncreaseAdultsCountCommand}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Padding="12" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                    StrokeShape="RoundRectangle 17" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{loc:Translate Children}" FontSize="14" FontAttributes="Bold"
                                           VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="44,Auto,44" ColumnSpacing="6" VerticalOptions="Center">
                                        <Button Text="−" WidthRequest="44" HeightRequest="44" Style="{StaticResource PackoCounterButtonStyle}" Command="{Binding DecreaseChildrenCountCommand}" />
                                        <Label Grid.Column="1" Text="{Binding ChildrenCount}" FontSize="17" FontAttributes="Bold"
                                               MinimumWidthRequest="32" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                        <Button Grid.Column="2" Text="+" WidthRequest="44" HeightRequest="44" Style="{StaticResource PackoCounterButtonStyle}" Command="{Binding IncreaseChildrenCountCommand}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding HasChildren}" Spacing="10"
                                             BindableLayout.ItemsSource="{Binding Children}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                            StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                                <Label Text="{loc:Translate Child}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                                <Label Text="{loc:Translate Age}" Style="{StaticResource PackoFieldCaptionStyle}" />
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                                <Button Text="−" Style="{StaticResource PackoCounterButtonStyle}" Command="{Binding DecreaseAgeCommand}" />
                                                <Label Text="{Binding Age}" FontSize="16" FontAttributes="Bold"
                                                       WidthRequest="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                                <Button Text="+" Style="{StaticResource PackoCounterButtonStyle}" Command="{Binding IncreaseAgeCommand}" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                        StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <VerticalStackLayout Spacing="13">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate TransportQuestion}" Style="{StaticResource PackoSectionTitleStyle}" />
                            <Label Text="{loc:Translate ChooseAllThatApply}" Style="{StaticResource PackoFieldCaptionStyle}" />
                        </VerticalStackLayout>
                        <FlexLayout BindableLayout.ItemsSource="{Binding TransportOptions}"
                                     Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="145" Margin="0,0,0,8" Padding="8,4"
                                            StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <CheckBox IsChecked="{Binding IsSelected}" Color="{StaticResource PackoAccentLight}"
                                                      MinimumWidthRequest="38" MinimumHeightRequest="42" />
                                            <Label Text="{Binding Name}" FontSize="14" VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Padding="18" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                        StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate TripTypeQuestion}" Style="{StaticResource PackoSectionTitleStyle}" />
                        <Label Text="{loc:Translate TripTypeDescription}" Style="{StaticResource PackoFieldCaptionStyle}" />
                        <Border Padding="12,1" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                            <Picker ItemsSource="{Binding TripTypeOptions}" ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedTripTypeOption}" FontSize="15" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Padding="20,12,20,18" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
            <Button Text="{Binding SubmitText}" Command="{Binding CreateTripCommand}"
                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                    FontSize="16" FontAttributes="Bold" CornerRadius="18"
                    HeightRequest="56" Padding="20,12" HorizontalOptions="Fill" />
        </Border>
    </Grid>
</local:BasePage>
