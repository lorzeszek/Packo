<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                xmlns:viewmodels="clr-namespace:Packo.ViewModels"
                xmlns:loc="clr-namespace:Packo.Extensions"
                xmlns:local="clr-namespace:Packo.Models.Pages"
                x:DataType="viewmodels:DocsViewModel"
                x:Class="Packo.Views.DocsPage"
                x:Name="DocsPageRoot"
                Title="{loc:Translate TabDocs}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="22,20,22,14" Spacing="6">
            <Label Text="{loc:Translate DocsEyebrow}" FontSize="11" CharacterSpacing="1.6"
                   FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
            <Label Text="{loc:Translate TabDocs}" FontSize="29" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="{loc:Translate DocsIntro}"
                   FontSize="14" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Docs}" SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="30" Spacing="13" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border WidthRequest="76" HeightRequest="76" StrokeThickness="0"
                            StrokeShape="RoundRectangle 25" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                            HorizontalOptions="Center">
                        <Label Text="▤" FontSize="34" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
                    </Border>
                    <Label Text="{loc:Translate NoDocs}" FontSize="19" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                    <Label Text="{loc:Translate AddPdfs}"
                           FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="TripDocument">
                    <Border Margin="20,6" Padding="12" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="48" HeightRequest="52" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                                    VerticalOptions="Center">
                                <Label Text="PDF" FontSize="11" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       TextColor="{StaticResource PackoAccentStrongLight}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding FileName}" FontSize="14" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                <Label Text="{Binding AddedAtDisplay}" FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2" Text="×" FontSize="23" Padding="0"
                                    WidthRequest="42" HeightRequest="42" CornerRadius="14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PackoRaisedSurfaceLight}, Dark={StaticResource PackoSubtleSurfaceDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoTertiaryTextDark}}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDocumentCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDocumentCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Padding="20,10,20,16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
            <Button Text="{loc:Translate AddDocument}" Command="{Binding AddDocumentCommand}"
                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                    FontSize="16" FontAttributes="Bold" CornerRadius="18"
                    HeightRequest="56" Padding="20,12" HorizontalOptions="Fill" />
        </Border>
    </Grid>
</local:BasePage>
