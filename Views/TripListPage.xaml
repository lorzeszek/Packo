<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                xmlns:loc="clr-namespace:Packo.Extensions"
                xmlns:local="clr-namespace:Packo.Models.Pages"
                x:DataType="TripListViewModel"
                x:Class="Packo.Views.TripListPage"
                x:Name="TripListView"
                Title="{Binding Title}"
                Shell.NavBarIsVisible="True"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <BoolToOpacityConverter x:Key="BoolToOpacityConverter" TrueOpacity="1" FalseOpacity="0.72" />
            <BoolToOppositeConverter x:Key="BoolToOppositeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
        <VerticalStackLayout Grid.Row="0" Padding="22,20,22,14" Spacing="6">
            <Label Text="{loc:Translate TripsEyebrow}" FontSize="11" CharacterSpacing="2.2"
                   FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
            <Label Text="{Binding Title}" FontSize="29" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="{loc:Translate TripsIntro}"
                   FontSize="14" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsLoading}" Spacing="12"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <ActivityIndicator IsRunning="{Binding IsLoading}" WidthRequest="36" HeightRequest="36"
                               Color="{StaticResource PackoAccentLight}" />
            <Label Text="{loc:Translate StartupLoadingTrips}" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasLoadError}" Spacing="16" Padding="32"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="{loc:Translate StartupLoadError}" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            <Button Text="{loc:Translate Retry}" Command="{Binding RetryLoadCommand}"
                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                    CornerRadius="18" Padding="24,12" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Trips}" SelectionMode="None"
                        IsVisible="{Binding ShowTrips}"
                        ItemsLayout="VerticalList" VerticalScrollBarVisibility="Never">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="14" VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="76" HeightRequest="76" StrokeThickness="0"
                            StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                            HorizontalOptions="Center">
                        <Label Text="✈" FontSize="32" Rotation="-12" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
                    </Border>
                    <Label Text="{loc:Translate NextAdventureWaiting}" FontSize="20" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                    <Label Text="{loc:Translate CreateTripToPack}"
                           FontSize="14" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="TripViewModel">
                    <Border Margin="20,8" Padding="0" StrokeThickness="0"
                            StrokeShape="RoundRectangle 24" HeightRequest="194"
                            Opacity="{Binding TripModel.IsActive, Converter={StaticResource BoolToOpacityConverter}}">
                        <Grid>
                            <Image Source="{Binding CoverImageSource}" Aspect="AspectFill" />
                            <BoxView IsVisible="{Binding TripModel.IsActive, Converter={StaticResource BoolToOppositeConverter}}"
                                     BackgroundColor="#241D19" Opacity="0.35" />

                            <Border HorizontalOptions="Start" VerticalOptions="End" Margin="14"
                                    Padding="14,10" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#B8181413">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Destination}" FontSize="21" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="White" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding TripDatesRange}" FontSize="12" TextColor="#F5FFFFFF" />
                                        <BoxView WidthRequest="3" HeightRequest="3" CornerRadius="2"
                                                 VerticalOptions="Center" Color="#D9FFFFFF" />
                                        <Label Text="{Binding PackingSummary}" FontSize="12" FontAttributes="Bold"
                                               TextColor="#F5FFFFFF" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border IsVisible="{Binding TripModel.IsActive, Converter={StaticResource BoolToOppositeConverter}}"
                                    HorizontalOptions="Start" VerticalOptions="Start" Margin="14"
                                    Padding="10,6" StrokeThickness="0" StrokeShape="RoundRectangle 13"
                                    BackgroundColor="#EFFFFFFF">
                                <Label Text="{loc:Translate PastTrip}" FontSize="10" CharacterSpacing="1.2"
                                       FontAttributes="Bold" TextColor="#5D514B" />
                            </Border>

                            <Button Text="&#xe3c9;" FontFamily="MaterialIcons" FontSize="22"
                                    HorizontalOptions="End" VerticalOptions="Start" Margin="0,10,64,0"
                                    WidthRequest="46" HeightRequest="46" Padding="6" CornerRadius="16"
                                    BackgroundColor="#FFFFFFE8" TextColor="#5D514B"
                                    SemanticProperties.Description="{loc:Translate EditTrip}"
                                    Command="{Binding BindingContext.EditTripCommand, Source={x:Reference TripListView}}"
                                    CommandParameter="{Binding .}" />

                            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="10"
                                    WidthRequest="46" HeightRequest="46" Padding="6"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                    BackgroundColor="#FFFFFFE8">
                                <LottieView Source="RecycleBin.lottie" AutoPlay="True"
                                            WidthRequest="34" HeightRequest="34"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                    <LottieView.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.TrashTripCommand, Source={x:Reference TripListView}}"
                                            CommandParameter="{Binding .}" />
                                    </LottieView.GestureRecognizers>
                                </LottieView>
                            </Border>
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.TripTappedCommand, Source={x:Reference TripListView}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" Padding="20,10,20,16" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
            <Button Text="{loc:Translate PlanTrip}" Command="{Binding AddTripCommand}"
                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                    FontSize="16" FontAttributes="Bold" CornerRadius="18"
                    HeightRequest="56" Padding="20,12" HorizontalOptions="Fill" />
        </Border>
    </Grid>
</local:BasePage>
