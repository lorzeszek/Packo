<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:loc="clr-namespace:Packo.Extensions"
             x:DataType="StartViewModel"
             x:Name="StartView"
             x:Class="Packo.Views.StartPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <BoolToOppositeConverter x:Key="BoolToOppositeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Grid IsVisible="{Binding HasTrip}" MinimumHeightRequest="340" IsClippedToBounds="True">
                <Image Source="{Binding Trip.CoverImageSource}" Aspect="AspectFill"
                       HeightRequest="340" InputTransparent="True" />
                <BoxView InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0" />
                            <GradientStop Color="#66000000" Offset="0.35" />
                            <GradientStop Color="#A6000000" Offset="0.75" />
                            <GradientStop Color="#B3000000" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <BoxView HeightRequest="100" VerticalOptions="End" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0"
                                          Color="{AppThemeBinding Light=#00F8F7F4, Dark=#00151515}" />
                            <GradientStop Offset="1"
                                          Color="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <Grid Padding="24,24,24,96" RowDefinitions="Auto,*,Auto" RowSpacing="24">
                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                           CharacterSpacing="1" TextColor="{StaticResource PackoWhite}" />
                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <Border Padding="11,6" HorizontalOptions="Start" StrokeThickness="1"
                                Stroke="#40FFFFFF" StrokeShape="RoundRectangle 12"
                                BackgroundColor="#40000000">
                            <Label Text="{Binding TripCountdown}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{StaticResource PackoWhite}" />
                        </Border>
                        <Label Text="{Binding TripDestination}" FontSize="34" FontAttributes="Bold"
                               TextColor="{StaticResource PackoWhite}" LineBreakMode="TailTruncation" MaxLines="3" />
                        <Label Text="{Binding TripDatesRange}" FontSize="14" TextColor="#F0FFFFFF" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsDataLoaded, Converter={StaticResource BoolToOppositeConverter}}"
                               IsVisible="{Binding IsDataLoaded, Converter={StaticResource BoolToOppositeConverter}}"
                               Margin="24" Color="{StaticResource PackoAccentLight}" />

            <VerticalStackLayout IsVisible="{Binding HasTrip}" Padding="24,0,24,32" Spacing="20">
                <Label Text="{loc:Translate StartIntro}"
                       FontSize="15" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />

                <Border Padding="22,20" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Translate StartTripGlance}" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                        <Label Text="{Binding TripDetailsSummary}"
                               FontSize="14" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                        <Button Text="{loc:Translate EditTrip}" Command="{Binding EditTripCommand}"
                                HorizontalOptions="Start" HeightRequest="44" Padding="14,0"
                                FontSize="13" FontAttributes="Bold" CornerRadius="13"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{loc:Translate PackingProgress}" FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                            <Label Grid.Column="1" Text="{Binding PackingProgressPercent}" FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
                        </Grid>
                        <ProgressBar Progress="{Binding PackingProgress}" HeightRequest="6"
                                     ProgressColor="{StaticResource PackoAccentLight}"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                     SemanticProperties.Description="{Binding PackingProgressText}" />
                        <Label Text="{Binding PackingProgressText}" FontSize="14" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextAltDark}}" />
                        <Button Text="{loc:Translate OpenPackingList}" Command="{Binding OpenPackingListCommand}"
                                HeightRequest="48" Padding="16,0" CornerRadius="14"
                                FontSize="14" FontAttributes="Bold"
                                BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasLoadError}" Spacing="16" Padding="32">
                <Label Text="{loc:Translate StartupLoadError}" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Button Text="{loc:Translate Retry}" Command="{Binding RetryLoadCommand}"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                        CornerRadius="18" Padding="24,12" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowTripUnavailable}" Spacing="16" Padding="32">
                <Label Text="{loc:Translate TripUnavailable}" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Button Text="{loc:Translate BackToTrips}" Command="{Binding BackToTripsCommand}"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                        CornerRadius="18" Padding="24,12" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
