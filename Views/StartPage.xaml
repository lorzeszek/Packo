<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:loc="clr-namespace:Packo.Extensions"
             xmlns:views="clr-namespace:Packo.Views"
             x:DataType="StartViewModel"
             x:Name="StartView"
             x:Class="Packo.Views.StartPage"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <BoolToOppositeConverter x:Key="BoolToOppositeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <Grid IsVisible="{Binding HasTrip}" MinimumHeightRequest="300" IsClippedToBounds="True">
                <Image Source="{Binding Trip.CoverImageSource}" Aspect="AspectFill"
                       HeightRequest="300" InputTransparent="True" />
                <BoxView InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0" />
                            <GradientStop Color="#66000000" Offset="0.35" />
                            <GradientStop Color="#A6000000" Offset="0.75" />
                            <GradientStop Color="#B3000000" Offset="1" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <BoxView HeightRequest="64" VerticalOptions="End" InputTransparent="True">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0"
                                          Color="{AppThemeBinding Light=#00F8F7F4, Dark=#00151515}" />
                            <GradientStop Offset="1"
                                          Color="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <Grid Padding="24,24,24,64" RowDefinitions="Auto,*,Auto" RowSpacing="24">
                    <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold"
                           CharacterSpacing="1" TextColor="{StaticResource PackoWhite}" />
                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <Border Padding="11,6" HorizontalOptions="Start" StrokeThickness="1"
                                Stroke="#40FFFFFF" StrokeShape="RoundRectangle 12"
                                BackgroundColor="#EFFFFFFF">
                            <Label Text="{Binding Trip.StatusLabel}" FontSize="11" FontAttributes="Bold"
                                   CharacterSpacing="1" TextColor="#5D514B" />
                        </Border>
                        <Label Text="{Binding TripDestination}" FontSize="34" FontAttributes="Bold"
                               TextColor="{StaticResource PackoWhite}" LineBreakMode="TailTruncation" MaxLines="3" />
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="6">
                            <Label Text="&#xe935;" FontFamily="MaterialIcons" FontSize="17"
                                   TextColor="#F0FFFFFF" VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1" Text="{Binding TripDatesRange}" FontSize="14"
                                   TextColor="#F0FFFFFF" LineBreakMode="WordWrap" />
                        </Grid>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="6"
                              IsVisible="{Binding Trip.IsCompleted, Converter={StaticResource BoolToOppositeConverter}}">
                            <Label Text="&#xe8b5;" FontFamily="MaterialIcons" FontSize="17"
                                   TextColor="#F0FFFFFF" VerticalOptions="Center"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1" Text="{Binding TripCountdown}" FontSize="12" TextColor="#F0FFFFFF" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoadingTrip}" IsVisible="{Binding IsLoadingTrip}"
                               Margin="24" Color="{StaticResource PackoAccentLight}" />

            <VerticalStackLayout IsVisible="{Binding HasTrip}" Padding="24,0,24,32" Spacing="20"
                                 MaximumWidthRequest="600" HorizontalOptions="Fill">
                <Label Text="{loc:Translate StartIntro}"
                       FontSize="13" LineBreakMode="WordWrap" Margin="0,0,0,4"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />

                <Border Style="{StaticResource PackoTripSectionCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Style="{StaticResource PackoTripIconTileStyle}">
                                <Label Text="&#xe8d0;" Style="{StaticResource PackoTripSectionIconStyle}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{loc:Translate StartTripGlance}" Style="{StaticResource PackoSectionTitleStyle}"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <Label Text="{Binding TripDetailsSummary}" Style="{StaticResource PackoFieldCaptionStyle}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}" />
                        <VerticalStackLayout Spacing="10">
                            <Button Text="{loc:Translate EditTrip}" Command="{Binding EditTripCommand}"
                                    IsVisible="{Binding Trip.CanManageTrip}"
                                    Style="{StaticResource PackoTripSecondaryButtonStyle}">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="&#xe3c9;" FontFamily="MaterialIcons" Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentDark}}" />
                                </Button.ImageSource>
                            </Button>
                            <Label Text="{loc:Translate TripShared}" IsVisible="{Binding Trip.IsShared}"
                                   Style="{StaticResource PackoFieldCaptionStyle}" FontAttributes="Bold" />
                            <Button x:Name="ShareTripButton" IsVisible="False" Text="{loc:Translate ShareTrip}"
                                    Clicked="OnShareTripClicked" Style="{StaticResource PackoTripOutlineButtonStyle}">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="&#xe80d;" FontFamily="MaterialIcons" Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                </Button.ImageSource>
                            </Button>
                            <Button x:Name="ManageSharingButton" IsVisible="False" Text="{loc:Translate ManageTripSharing}"
                                    Clicked="OnManageSharingClicked" Style="{StaticResource PackoTripOutlineButtonStyle}">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="&#xe7ef;" FontFamily="MaterialIcons" Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource PackoTripSectionCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Style="{StaticResource PackoTripIconTileStyle}">
                                <Label Text="&#xe7f4;" Style="{StaticResource PackoTripSectionIconStyle}" />
                            </Border>
                            <Label Grid.Column="1" Text="{loc:Translate Reminders}" Style="{StaticResource PackoSectionTitleStyle}"
                                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                        </Grid>
                        <Label x:Name="RemindersSummary" Style="{StaticResource PackoFieldCaptionStyle}" LineBreakMode="WordWrap" />
                        <Button Text="{loc:Translate RemindersOpen}" Clicked="OnRemindersClicked"
                                Style="{StaticResource PackoTripSecondaryButtonStyle}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource PackoTripSectionCardStyle}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border Style="{StaticResource PackoTripIconTileStyle}">
                                <Label Text="&#xe55f;" Style="{StaticResource PackoTripSectionIconStyle}" />
                            </Border>
                            <Label Grid.Column="1" Text="{loc:Translate PlacesTitle}" Style="{StaticResource PackoSectionTitleStyle}"
                                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                        </Grid>
                        <Label x:Name="PlacesSummary" Text="{loc:Translate PlacesEntryIntro}"
                               Style="{StaticResource PackoFieldCaptionStyle}" LineBreakMode="WordWrap" />
                        <Button Text="{loc:Translate PlacesOpen}" Clicked="OnPlacesClicked"
                                Style="{StaticResource PackoTripSecondaryButtonStyle}" />
                    </VerticalStackLayout>
                </Border>
                <views:PackingListsView x:Name="PackingLists" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasLoadError}" Spacing="16" Padding="32">
                <Label Text="{loc:Translate StartupLoadError}" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Button Text="{loc:Translate Retry}" Clicked="OnRetryClicked"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                        CornerRadius="18" Padding="24,12" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowTripUnavailable}" Spacing="16" Padding="32">
                <Label Text="{loc:Translate TripUnavailable}" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Button Text="{loc:Translate BackToTrips}" Command="{Binding BackToTripsCommand}"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}"
                        CornerRadius="18" Padding="24,12" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
