<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Packo.Extensions"
             x:Class="Packo.Views.StartupPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
    <Grid Padding="32">
        <VerticalStackLayout Spacing="18" VerticalOptions="Center"
                             HorizontalOptions="Fill" MaximumWidthRequest="320">
            <Grid x:Name="LoadingTrack" HeightRequest="4" IsClippedToBounds="True"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                  Loaded="OnLoadingTrackLoaded" Unloaded="OnLoadingTrackUnloaded"
                  SizeChanged="OnLoadingTrackSizeChanged">
                <BoxView x:Name="LoadingSegment" WidthRequest="80" HorizontalOptions="Start"
                         TranslationX="-80" Color="{StaticResource PackoAccentLight}" />
            </Grid>
            <Label x:Name="StatusLabel" Text="{loc:Translate StartupPreparing}"
                   FontSize="15" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            <Button x:Name="RetryButton" Text="{loc:Translate Retry}" IsVisible="False"
                    Clicked="OnRetryClicked" CornerRadius="18" Padding="24,12"
                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
