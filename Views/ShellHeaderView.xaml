<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:loc="clr-namespace:Packo.Extensions"
             xmlns:viewmodels="clr-namespace:Packo.ViewModels"
             xmlns:converters="clr-namespace:Packo.Converters"
             x:Class="Packo.Views.ShellHeaderView"
             x:DataType="viewmodels:ShellHeaderViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}"
             MinimumHeightRequest="52">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid Padding="16,4" ColumnDefinitions="*,Auto" ColumnSpacing="12"
          BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0"
                    StrokeShape="RoundRectangle 12" BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}">
                <Label Text="✈" FontSize="17" HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource PackoAccentLight}, Dark={StaticResource PackoAccentDark}}" />
            </Border>
            <Label Text="Packo" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
        </HorizontalStackLayout>

        <Button Grid.Column="1" Text="{loc:Translate Login}"
                Command="{Binding LoginWithGoogleCommand}"
                IsVisible="{Binding Session.IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentLight}, Dark={StaticResource PackoShellAccentLight}}"
                TextColor="{StaticResource PackoWhite}" CornerRadius="14" Padding="16,7"
                MinimumHeightRequest="40" FontSize="13" FontAttributes="Bold"
                VerticalOptions="Center" />

        <Border Grid.Column="1" IsVisible="{Binding Session.IsAuthenticated, Converter={StaticResource BoolToVisibilityConverter}}"
                Padding="8,4,5,4" StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="7" VerticalOptions="Center">
                <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0"
                        StrokeShape="RoundRectangle 10" BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}">
                    <Grid>
                        <Image Source="{Binding Session.AvatarUrl}" Aspect="AspectFill"
                               IsVisible="{Binding Session.HasAvatar}" />
                        <Label Text="{Binding Session.UserInitial}" FontSize="12" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                               IsVisible="{Binding Session.HasAvatar, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                               TextColor="{AppThemeBinding Light={StaticResource PackoAccentLight}, Dark={StaticResource PackoAccentDark}}" />
                    </Grid>
                </Border>
                <Button Grid.Column="1" Text="{loc:Translate Logout}" Command="{Binding LogoutCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentDark}}"
                        CornerRadius="12" Padding="10,5" MinimumHeightRequest="34"
                        FontSize="12" FontAttributes="Bold" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
