<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Packo.Extensions"
             xmlns:vm="clr-namespace:Packo.ViewModels"
             x:Class="Packo.Views.TripPlacesPage" x:Name="PlacesPage"
             x:DataType="vm:TripPlacesViewModel" Title="{loc:Translate PlacesTitle}"
             BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">
    <ContentPage.Resources>
        <Style x:Key="PlaceActionButton" TargetType="Button">
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ContentLayout" Value="Left,6" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
            <Style.Triggers>
                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlaceDangerButton" TargetType="Button" BasedOn="{StaticResource PlaceActionButton}">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FDE8E7, Dark=#432429}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#9E3030, Dark=#F3A7A6}" />
        </Style>
        <FontImageSource x:Key="PlaceFindIcon" FontFamily="MaterialIcons" Glyph="&#xE87A;" Size="21" Color="White" />
        <FontImageSource x:Key="PlaceAddIcon" FontFamily="MaterialIcons" Glyph="&#xE145;" Size="20" Color="White" />
        <FontImageSource x:Key="PlaceSavedIcon" FontFamily="MaterialIcons" Glyph="&#xE5CA;" Size="20" Color="White" />
        <FontImageSource x:Key="PlaceMapIcon" FontFamily="MaterialIcons" Glyph="&#xE55B;" Size="18"
                         Color="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
        <FontImageSource x:Key="PlaceWebsiteIcon" FontFamily="MaterialIcons" Glyph="&#xE894;" Size="18"
                         Color="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
        <FontImageSource x:Key="PlacePhotosIcon" FontFamily="MaterialIcons" Glyph="&#xE413;" Size="18"
                         Color="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
        <FontImageSource x:Key="PlaceVisitedIcon" FontFamily="MaterialIcons" Glyph="&#xE86C;" Size="18"
                         Color="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
        <FontImageSource x:Key="PlaceNoteIcon" FontFamily="MaterialIcons" Glyph="&#xE3C9;" Size="18"
                         Color="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
        <FontImageSource x:Key="PlaceRemoveIcon" FontFamily="MaterialIcons" Glyph="&#xE872;" Size="18"
                         Color="{AppThemeBinding Light=#9E3030, Dark=#F3A7A6}" />
        <FontImageSource x:Key="PlaceClearIcon" FontFamily="MaterialIcons" Glyph="&#xE16C;" Size="18"
                         Color="{AppThemeBinding Light=#9E3030, Dark=#F3A7A6}" />
        <FontImageSource x:Key="PlaceExternalIcon" FontFamily="MaterialIcons" Glyph="&#xE89E;" Size="16"
                         Color="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
    <CollectionView ItemsSource="{Binding Items}" SelectionMode="None" Margin="22,16,22,0">
        <CollectionView.Header>
        <VerticalStackLayout Spacing="12" Margin="0,0,0,12">
            <Label Text="{Binding Destination}" FontSize="25" FontAttributes="Bold" MaxLines="2"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Border IsVisible="{Binding IsOffline}" Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}">
                <Label Text="{loc:Translate PlacesOffline}" FontSize="13" LineBreakMode="WordWrap"
                       SemanticProperties.Description="{loc:Translate PlacesOffline}"
                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{loc:Translate PlacesSuggestions}" Command="{Binding ShowSuggestionsCommand}"
                        HeightRequest="46" CornerRadius="14" FontSize="13" FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowSuggestions}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PackoAccentLight}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="{Binding SavedTabLabel}" Command="{Binding ShowSavedCommand}"
                        HeightRequest="46" CornerRadius="14" FontSize="13" FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ShowSaved}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource PackoAccentLight}" />
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <VerticalStackLayout IsVisible="{Binding ShowSuggestions}" Spacing="8">
                <Label Text="{loc:Translate PlacesIntro}" FontSize="13" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Label Text="{loc:Translate PlacesSignInRequired}" IsVisible="{Binding NeedsSignIn}" FontSize="13" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Button Text="{loc:Translate PlacesFind}" Command="{Binding FindCommand}" AutomationId="FindPlacesButton"
                        ImageSource="{StaticResource PlaceFindIcon}" ContentLayout="Left,8"
                        HeightRequest="48" CornerRadius="14" FontAttributes="Bold"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="White" />
            </VerticalStackLayout>
            <VerticalStackLayout IsVisible="{Binding ShowSaved}" Spacing="8">
                <Label Text="{loc:Translate PlacesLocalList}" FontSize="12" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                <Button Text="{loc:Translate PlacesAddManual}" Clicked="OnAddManualClicked" IsEnabled="{Binding CanEdit}"
                        ImageSource="{StaticResource PlaceAddIcon}" ContentLayout="Left,8"
                        HeightRequest="48" CornerRadius="14" FontAttributes="Bold"
                        BackgroundColor="{StaticResource PackoAccentLight}" TextColor="White" />
                <Button Text="{loc:Translate PlacesClearList}" Clicked="OnClearListClicked" AutomationId="ClearPlacesButton"
                        IsVisible="{Binding HasSaved}" IsEnabled="{Binding CanClearSaved}"
                        ImageSource="{StaticResource PlaceClearIcon}" Style="{StaticResource PlaceDangerButton}"
                        HorizontalOptions="Start" Margin="0" FontSize="13" FontAttributes="Bold" />
            </VerticalStackLayout>
            <HorizontalStackLayout IsVisible="{Binding IsWorking}" Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsWorking}" Color="{StaticResource PackoAccentLight}" WidthRequest="24" />
                <Label Text="{loc:Translate PlacesWorking}" FontSize="13" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            </HorizontalStackLayout>
            <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="13" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentDark}}" />
        </VerticalStackLayout>
        </CollectionView.Header>
            <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12" /></CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}" Padding="8,24" FontSize="14" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            </CollectionView.EmptyView>
            <CollectionView.Footer><Grid HeightRequest="24" BackgroundColor="Transparent" /></CollectionView.Footer>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TripPlaceCardViewModel">
                    <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding CategoryLabel}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoShellAccentLight}, Dark={StaticResource PackoAccentDark}}" />
                            <Label Text="{Binding DisplayName}" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                            <Label Text="{Binding DisplayDescription}" IsVisible="{Binding HasDescription}" FontSize="14" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                            <Label Text="{Binding Place.UserNote}" IsVisible="{Binding HasNote}" FontSize="14" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Place.Attributions}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="PlaceAttribution">
                                        <Label Text="{Binding Name}" FontSize="12" TextDecorations="Underline"
                                               TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}">
                                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnAttributionTapped" /></Label.GestureRecognizers>
                                        </Label>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                                <Button Text="{loc:Translate PlacesMap}" Clicked="OnMapClicked"
                                        Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlaceMapIcon}" />
                                <Button Text="{loc:Translate PlacesWebsite}" Clicked="OnWebsiteClicked" IsVisible="{Binding HasWebsite}"
                                        Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlaceWebsiteIcon}" />
                                <Button Text="Wikipedia" Clicked="OnSourceClicked" IsVisible="{Binding HasSource}"
                                        Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlaceWebsiteIcon}" />
                                <Button Text="{loc:Translate PlacesPhotos}" Clicked="OnDetailsClicked" IsVisible="{Binding IsGoogle}"
                                        Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlacePhotosIcon}" />
                            </FlexLayout>
                            <Button Text="{Binding SaveLabel}" Clicked="OnSaveClicked" IsVisible="{Binding ShowSaveAction}" IsEnabled="{Binding CanSave}"
                                    ImageSource="{StaticResource PlaceAddIcon}" ContentLayout="Left,6"
                                    HeightRequest="46" CornerRadius="13" FontAttributes="Bold"
                                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="White">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSaved}" Value="True">
                                        <Setter Property="ImageSource" Value="{StaticResource PlaceSavedIcon}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <VerticalStackLayout IsVisible="{Binding ShowSavedActions}" IsEnabled="{Binding CanEdit}" Spacing="8">
                                <Button Text="{Binding VisitLabel}" Clicked="OnVisitClicked" Margin="0"
                                        Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlaceVisitedIcon}" />
                                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center">
                                    <Button Text="{loc:Translate PlacesMyNote}" Clicked="OnEditPlaceClicked" IsVisible="{Binding IsGoogle}"
                                            Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlaceNoteIcon}" />
                                    <Button Text="{loc:Translate PlacesEditPlace}" Clicked="OnEditPlaceClicked" IsVisible="{Binding IsManual}"
                                            Style="{StaticResource PlaceActionButton}" ImageSource="{StaticResource PlaceNoteIcon}" />
                                    <Button Text="{loc:Translate PlacesRemove}" Clicked="OnRemoveClicked"
                                            Style="{StaticResource PlaceDangerButton}" ImageSource="{StaticResource PlaceRemoveIcon}" />
                                </FlexLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
    </CollectionView>
    <Button Grid.Row="1" Text="Google Maps" Clicked="OnGoogleMapsClicked" IsVisible="{Binding HasGooglePlaces}"
            ImageSource="{StaticResource PlaceExternalIcon}" ContentLayout="Right,6"
            SemanticProperties.Hint="{loc:Translate PlacesOpenGoogleMaps}" AutomationId="PlacesGoogleMapsAttribution"
            HorizontalOptions="Center" HeightRequest="44" Margin="22,0,22,4" Padding="12,0"
            BackgroundColor="Transparent" BorderWidth="0" FontSize="12" FontAttributes="None"
            TextColor="{AppThemeBinding Light=#1F1F1F, Dark=White}" />
    </Grid>
</ContentPage>
