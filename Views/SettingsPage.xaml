<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:local="clr-namespace:Packo.Models.Pages"
                xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:viewmodels="clr-namespace:Packo.ViewModels"
                x:Class="Packo.Views.SettingsPage"
                x:DataType="viewmodels:SettingsViewModel"
                Title="Settings"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="22,22,22,30" Spacing="22">
            <VerticalStackLayout Spacing="7">
                <Label Text="MAKE IT YOURS" FontSize="11" CharacterSpacing="2.2"
                       FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
                <Label Text="Settings" FontSize="30" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                <Label Text="A few small touches to make Packo feel like home."
                       FontSize="14" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            </VerticalStackLayout>

            <Border Padding="18" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                    StrokeShape="RoundRectangle 22" BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                        <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                StrokeShape="RoundRectangle 16" BackgroundColor="{StaticResource PackoAccentSoftLight}">
                            <Label Text="☼" FontSize="28" HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Appearance" FontSize="18" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                            <Label Text="Choose how Packo looks on this device."
                                   FontSize="13" LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Color theme" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                        <Border Padding="12,3" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                                StrokeShape="RoundRectangle 15" BackgroundColor="{AppThemeBinding Light={StaticResource PackoWhite}, Dark={StaticResource PackoInsetSurfaceDeepDark}}">
                            <Picker Title="Select a theme" ItemsSource="{Binding ThemeOptions}"
                                    SelectedItem="{Binding SelectedTheme}" FontSize="15" />
                        </Border>
                        <Label Text="System follows your device setting. Light and Dark stay fixed."
                               FontSize="12" LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                    BackgroundColor="{StaticResource PackoAccentSoftLight}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="✦" FontSize="19" VerticalTextAlignment="Center"
                           TextColor="{StaticResource PackoAccentLight}" />
                    <Label Grid.Column="1" Text="Your theme choice is saved automatically."
                           FontSize="13" VerticalTextAlignment="Center" LineBreakMode="WordWrap"
                           TextColor="{StaticResource PackoAccentStrongLight}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</local:BasePage>
