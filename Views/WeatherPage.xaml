<?xml version="1.0" encoding="utf-8" ?>
<local:BasePage xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                xmlns:loc="clr-namespace:Packo.Extensions"
                xmlns:viewmodels="clr-namespace:Packo.ViewModels"
                xmlns:local="clr-namespace:Packo.Models.Pages"
                xmlns:dto="clr-namespace:Packo.Models.DTO"
                x:DataType="viewmodels:WeatherViewModel"
                x:Class="Packo.Views.WeatherPage"
                Title="{loc:Translate TabWeather}"
                BackgroundColor="{AppThemeBinding Light={StaticResource PackoPageBackgroundLight}, Dark={StaticResource PackoPageBackgroundDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="WeatherCoolTextLight">#397D9D</Color>
            <Color x:Key="WeatherCoolTextDark">#9BD5EA</Color>
            <Color x:Key="WeatherCoolSurfaceLight">#E9F3F7</Color>
            <Color x:Key="WeatherCoolSurfaceDark">#233840</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="22,20,22,14" Spacing="6">
            <Label Text="{loc:Translate WeatherEyebrow}" FontSize="11" CharacterSpacing="2.1"
                   FontAttributes="Bold" TextColor="{StaticResource PackoAccentLight}" />
            <Label Text="{loc:Translate TabWeather}" FontSize="29" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="{loc:Translate WeatherIntro}"
                   FontSize="14" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsLoading}" Padding="24" Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource PackoAccentLight}"
                               HeightRequest="36" WidthRequest="36" />
            <Label Text="{loc:Translate WeatherLoading}" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding HasLoadError}" Padding="24" Spacing="14">
            <Label Text="{Binding LoadErrorMessage}" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            <Button Text="{loc:Translate Retry}" Command="{Binding RetryLoadCommand}"
                    HorizontalOptions="Center" CornerRadius="18" Padding="24,12"
                    BackgroundColor="{StaticResource PackoAccentLight}" TextColor="{StaticResource PackoWhite}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Destinations}" IsVisible="{Binding HasForecasts}"
                        SelectionMode="None" VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:DestinationWeatherDTO">
                    <Border Margin="20,8" Padding="18" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PackoSurfaceLight}, Dark={StaticResource PackoSurfaceDark}}">
                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Destination}" FontSize="20" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                <Label Text="{loc:Translate CurrentConditions}" FontSize="10" CharacterSpacing="1.4"
                                       FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
                                <Image Source="{Binding WeatherIcon}" HeightRequest="48" WidthRequest="48"
                                       VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Grid.Column="1" Text="{Binding ConditionDescription}" FontSize="15"
                                       VerticalOptions="Center" LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                <Border Grid.Column="2" Padding="13,9" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsFreezing}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WeatherCoolSurfaceLight}, Dark={StaticResource WeatherCoolSurfaceDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding CurrentWeather.Temperature, StringFormat='{}{0:0}°'}"
                                               FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentStrongDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsFreezing}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WeatherCoolTextLight}, Dark={StaticResource WeatherCoolTextDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <HorizontalStackLayout Spacing="3" IsVisible="{Binding IsFreezing}" HorizontalOptions="Center">
                                            <Image Source="weather_snow.png" WidthRequest="13" HeightRequest="13"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Text="{loc:Translate WeatherFreezing}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource WeatherCoolTextLight}, Dark={StaticResource WeatherCoolTextDark}}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoRaisedSurfaceLight}, Dark={StaticResource PackoRaisedSurfaceDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHighHumidity}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WeatherCoolSurfaceLight}, Dark={StaticResource WeatherCoolSurfaceDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="5">
                                        <HorizontalStackLayout Spacing="6">
                                            <Image Source="weather_humidity.png" WidthRequest="20" HeightRequest="20"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Text="{loc:Translate Humidity}" FontSize="9" CharacterSpacing="0.5"
                                                   VerticalOptions="Center" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding CurrentWeather.Humidity, StringFormat='{}{0}%'}" FontSize="20"
                                               FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                        <Label Text="{Binding HumidityDescription}" FontSize="11" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Padding="12,10" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoRaisedSurfaceLight}, Dark={StaticResource PackoRaisedSurfaceDark}}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsWindy}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PackoAccentSoftLight}, Dark={StaticResource PackoAccentSoftDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="5">
                                        <HorizontalStackLayout Spacing="6">
                                            <Image Source="weather_wind.png" WidthRequest="20" HeightRequest="20"
                                                   AutomationProperties.IsInAccessibleTree="False" />
                                            <Label Text="{loc:Translate Wind}" FontSize="9" CharacterSpacing="0.5"
                                                   VerticalOptions="Center" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding CurrentWeather.WindSpeed, StringFormat='{}{0:0} km/h'}" FontSize="20"
                                               FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                        <Label Text="{Binding WindDescription}" FontSize="11" LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsWindy}" Value="True">
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PackoAccentStrongLight}, Dark={StaticResource PackoAccentStrongDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource PackoBorderLight}, Dark={StaticResource PackoBorderDark}}" />
                            <Label Text="{loc:Translate Forecast15Day}" FontSize="10" CharacterSpacing="1.4"
                                   FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />

                            <CollectionView ItemsSource="{Binding ForecastDays}" ItemsLayout="HorizontalList"
                                            HeightRequest="144" SelectionMode="None"
                                            HorizontalScrollBarVisibility="Never">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:DailyForecastDTO">
                                        <Border Margin="0,0,8,0" Padding="10,9" MinimumWidthRequest="64" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 15"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource PackoRaisedSurfaceLight}, Dark={StaticResource PackoRaisedSurfaceDark}}">
                                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="{Binding Date, StringFormat='{}{0:ddd}'}" FontSize="11"
                                                           FontAttributes="Bold" HorizontalTextAlignment="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                                    <Label Text="{Binding Date, StringFormat='{}{0:dd.MM}'}" FontSize="11"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
                                                </VerticalStackLayout>
                                                <Image Source="{Binding WeatherIcon}" WidthRequest="28" HeightRequest="28"
                                                       HorizontalOptions="Center" SemanticProperties.Description="{Binding ConditionDescription}" />
                                                <Label Text="{Binding MaxTemp, StringFormat='{}{0:0}°'}" FontSize="15"
                                                       FontAttributes="Bold" HorizontalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                                                <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                                    <Image Source="weather_snow.png" WidthRequest="12" HeightRequest="12"
                                                           IsVisible="{Binding IsFreezing}" VerticalOptions="Center"
                                                           SemanticProperties.Description="{loc:Translate WeatherFreezing}" />
                                                    <Label Text="{Binding MinTemp, StringFormat='{}{0:0}°'}" FontSize="12"
                                                           HorizontalTextAlignment="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsFreezing}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WeatherCoolTextLight}, Dark={StaticResource WeatherCoolTextDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding ShowEmptyState}" Padding="32" Spacing="14"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Border WidthRequest="76" HeightRequest="76" StrokeThickness="0"
                    StrokeShape="RoundRectangle 26" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                    HorizontalOptions="Center">
                <Label Text="☼" FontSize="42" HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
            </Border>
            <Label Text="{loc:Translate NoForecasts}" FontSize="20" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
            <Label Text="{loc:Translate AddTripForecast}" FontSize="14" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
        </VerticalStackLayout>
    </Grid>
</local:BasePage>
