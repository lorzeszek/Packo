<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:TypeArguments="x:Boolean"
    x:Class="Packo.Popups.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Style="{StaticResource PackoPopupCardStyle}">
        <VerticalStackLayout Spacing="16">
            <Label x:Name="TitleLabel" Style="{StaticResource PackoPopupTitleStyle}" />

            <Label x:Name="MessageLabel" FontSize="14"
                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                <Button x:Name="CancelButton" Clicked="OnCancelClicked"
                        Style="{StaticResource PackoPopupSecondaryButtonStyle}" />
                <Button x:Name="ConfirmButton" Grid.Column="1" Clicked="OnConfirmClicked"
                        Style="{StaticResource PackoPopupPrimaryButtonStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
