<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:TypeArguments="x:Boolean"
    x:Class="Packo.Popups.ConfirmPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border Padding="24" Margin="20" Style="{StaticResource PackoCardBorderStyle}"
            StrokeShape="RoundRectangle 26">
        <VerticalStackLayout Spacing="16">
            <Border WidthRequest="54" HeightRequest="54" StrokeThickness="0"
                    StrokeShape="RoundRectangle 18" BackgroundColor="{StaticResource PackoAccentSoftLight}"
                    HorizontalOptions="Center">
                <Label Text="✦" FontSize="26" HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" TextColor="{StaticResource PackoAccentLight}" />
            </Border>

            <Label x:Name="TitleLabel" Text="Confirm" FontSize="20" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />

            <Label x:Name="MessageLabel" Text="Are you sure?" FontSize="14"
                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                <Button Text="No" Clicked="OnCancelClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoSubtleSurfaceLight}, Dark={StaticResource PackoSubtleSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}"
                        FontSize="15" FontAttributes="Bold" CornerRadius="15" HeightRequest="52" />
                <Button Grid.Column="1" Text="Yes" Clicked="OnConfirmClicked"
                        Style="{StaticResource PackoPrimaryActionButtonStyle}"
                        FontSize="15" FontAttributes="Bold" CornerRadius="15" HeightRequest="52" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
