<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:TypeArguments="x:String"
    x:Class="Packo.Popups.PackingListNamePopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Packo.Extensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Padding="0"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border x:Name="PopupCard" Style="{StaticResource PackoPopupCardStyle}">
        <VerticalStackLayout Spacing="16">
            <Label x:Name="TitleLabel" Style="{StaticResource PackoPopupTitleStyle}" />

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Translate PackingListName}" Style="{StaticResource PackoFieldCaptionStyle}" />
                <Border Padding="12,0" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                        Stroke="{AppThemeBinding Light={StaticResource PackoControlBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoRaisedSurfaceLight}, Dark={StaticResource PackoRaisedSurfaceDark}}">
                    <Entry x:Name="NameEntry" Completed="OnSaveClicked"
                           ReturnType="Done" MinimumHeightRequest="48"
                           SemanticProperties.Description="{loc:Translate PackingListName}" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{loc:Translate Cancel}" Clicked="OnCancelClicked"
                        Style="{StaticResource PackoPopupSecondaryButtonStyle}" />
                <Button x:Name="SaveButton" Grid.Column="1" Text="{loc:Translate SaveChanges}" Clicked="OnSaveClicked"
                        Style="{StaticResource PackoPopupPrimaryButtonStyle}" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
