<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:TypeArguments="x:Int32"
    x:Class="Packo.Popups.PackingQuantityPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:Packo.Extensions"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    Padding="0"
    CanBeDismissedByTappingOutsideOfPopup="False">

    <Border WidthRequest="280" Padding="20" Style="{StaticResource PackoCardBorderStyle}"
            StrokeShape="RoundRectangle 24">
        <VerticalStackLayout x:Name="EditorContent" Spacing="16">
            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Translate PackingQuantity}" FontSize="20" FontAttributes="Bold"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                <Label x:Name="ItemNameLabel" FontSize="14" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PackoSecondaryTextLight}, Dark={StaticResource PackoSecondaryTextDark}}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="44,*,44" ColumnSpacing="10">
                <Button x:Name="DecreaseButton" Text="−" Clicked="OnDecreaseClicked"
                        Style="{StaticResource PackoCounterButtonStyle}"
                        WidthRequest="44" HeightRequest="48" MinimumWidthRequest="44" MinimumHeightRequest="44"
                        SemanticProperties.Description="{loc:Translate DecreasePackingQuantity}" />
                <Border Grid.Column="1" Padding="4,0" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                        Stroke="{AppThemeBinding Light={StaticResource PackoControlBorderLight}, Dark={StaticResource PackoControlBorderDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoRaisedSurfaceLight}, Dark={StaticResource PackoRaisedSurfaceDark}}">
                    <Entry x:Name="QuantityEntry" Keyboard="Numeric" ReturnType="Done"
                           TextChanged="OnQuantityTextChanged" Completed="OnConfirmClicked"
                           FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"
                           MinimumHeightRequest="48" BackgroundColor="Transparent"
                           SemanticProperties.Description="{loc:Translate PackingQuantity}"
                           TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}" />
                </Border>
                <Button x:Name="IncreaseButton" Grid.Column="2" Text="+" Clicked="OnIncreaseClicked"
                        Style="{StaticResource PackoCounterButtonStyle}"
                        WidthRequest="44" HeightRequest="48" MinimumWidthRequest="44" MinimumHeightRequest="44"
                        SemanticProperties.Description="{loc:Translate IncreasePackingQuantity}" />
            </Grid>

            <Label x:Name="ValidationLabel" Text="{loc:Translate PackingQuantityInvalid}"
                   IsVisible="False" FontSize="13" LineBreakMode="WordWrap" TextColor="#C24141" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{loc:Translate Cancel}" Clicked="OnCancelClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PackoSubtleSurfaceLight}, Dark={StaticResource PackoSubtleSurfaceDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PackoPrimaryTextLight}, Dark={StaticResource PackoPrimaryTextDark}}"
                        FontSize="14" FontAttributes="Bold" CornerRadius="14" HeightRequest="48" Padding="4,0" />
                <Button x:Name="ConfirmButton" Grid.Column="1" Text="{loc:Translate SaveChanges}" Clicked="OnConfirmClicked"
                        Style="{StaticResource PackoPrimaryActionButtonStyle}"
                        FontSize="14" FontAttributes="Bold" CornerRadius="14" HeightRequest="48" Padding="4,0" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
