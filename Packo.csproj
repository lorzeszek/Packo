  <ItemGroup>
    <None Update="Popups\GeneratePackingPopup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="Popups\PackingItemsPopup.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>
</Project>
