      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </MauiAsset>
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Update="Resources\Raw\RecycleBin.lottie">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </MauiAsset>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <PackageReference Include="Xamarin.AndroidX.Credentials">
